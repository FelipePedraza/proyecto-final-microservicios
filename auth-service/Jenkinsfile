pipeline {
    agent none
    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
    }
    triggers {
        pollSCM('H/5 * * * *')
    }
    environment {
        MVN_OPTS = '-B -Dmaven.repo.local=/tmp/.m2/repository'
    }
    stages {
        stage('Checkout') {
            agent any
            steps {
                checkout scm
                echo 'Código fuente obtenido'
            }
        }
        stage('Build') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21'
                    args '--network microservicios-network -v maven_repo_cache:/tmp -e HOME=/tmp'
                }
            }
            steps {
                dir('auth-service') {
                    sh 'mvn $MVN_OPTS clean compile -DskipTests'
                }
            }
        }
        stage('Test') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21'
                    args '--network microservicios-network -v maven_repo_cache:/tmp -e HOME=/tmp'
                }
            }
            steps {
                dir('auth-service') {
                    // verify ejecuta las pruebas y genera JaCoCo. Se deja que
                    // Surefire termine para que junit publique los fallos y marque
                    // el build UNSTABLE, en vez de abortar antes del bloque post.
                    sh 'mvn $MVN_OPTS verify -Dmaven.test.failure.ignore=true'
                }
                stash name: 'auth-jacoco-report', includes: 'auth-service/target/site/jacoco/jacoco.xml'
            }
            post {
                always {
                    junit 'auth-service/target/surefire-reports/*.xml'
                    recordCoverage(
                        tools: [[parser: 'JACOCO', pattern: 'auth-service/target/site/jacoco/jacoco.xml']],
                        sourceDirectories: [[path: 'auth-service/src/main/java']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                    archiveArtifacts artifacts: 'auth-service/target/site/jacoco/**', allowEmptyArchive: true
                }
            }
        }
        stage('SonarQube Analysis') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21'
                    args '--network microservicios-network -v maven_repo_cache:/tmp -e HOME=/tmp'
                }
            }
            steps {
                unstash 'auth-jacoco-report'
                dir('auth-service') {
                    withSonarQubeEnv('sonarqube') {
                        sh '''
                            mvn $MVN_OPTS \
                              org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                              -Dsonar.projectKey=auth-service \
                              -Dsonar.projectName=auth-service \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                              -Dsonar.token=$SONAR_AUTH_TOKEN
                        '''
                    }
                }
            }
        }
        stage('Quality Gate') {
            agent any
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Package') {
            agent any
            steps {
                script {
                    def imageName = "auth-service"
                    def imageTag = "${env.BUILD_NUMBER}"
                    echo "Empaquetando imagen Docker: ${imageName}:${imageTag}"
                    dir('auth-service') {
                        sh "docker build -t ${imageName}:${imageTag} -t ${imageName}:latest ."
                    }
                    echo "Imagen construida exitosamente: ${imageName}:${imageTag}"
                }
            }
        }
        stage('E2E Tests') {
            agent any
            steps {
                script {
                    def config = readProperties(file: env.DOTENV_FILE)
                    def appServices = config.APP_SERVICES?.trim()
                    def e2eBaseUrl = config.JENKINS_E2E_BASE_URL ?: config.E2E_BASE_URL
                    def jwtSecret = config.JWT_SECRET_KEY
                    if (!appServices || !e2eBaseUrl?.trim() || !jwtSecret?.trim()) {
                        error 'El archivo de entorno debe definir APP_SERVICES, E2E_BASE_URL y JWT_SECRET_KEY'
                    }
                    env.APP_SERVICES = appServices
                    env.E2E_BASE_URL = e2eBaseUrl
                    env.E2E_ADMIN_EMAIL = config.E2E_ADMIN_EMAIL ?: config.ADMIN_EMAIL ?: ''
                    env.E2E_ADMIN_PASSWORD = config.E2E_ADMIN_PASSWORD ?: config.ADMIN_PASSWORD ?: ''
                    env.E2E_JWT_SECRET = jwtSecret
                    env.AUTH_SERVICE_IMAGE_TAG = env.BUILD_NUMBER
                    env.VACACIONES_MANUAL_ENABLED = 'true'
                }

                echo "Limpiando estado previo de microservicios y volumenes..."
                sh '''
                    if [ -z "${APP_SERVICES:-}" ]; then
                        echo "ERROR: APP_SERVICES está vacío; se cancela la limpieza." >&2
                        exit 1
                    fi
                    docker compose --env-file "$DOTENV_FILE" stop $APP_SERVICES || true
                    docker compose --env-file "$DOTENV_FILE" rm -f -v $APP_SERVICES || true
                    docker volume rm -f microservicios_empleado-data microservicios_departamento-data microservicios_notificaciones-data microservicios_perfiles-data microservicios_vacaciones-data microservicios_auth_db_data microservicios_rabbitmq-data || true
                '''

                echo "Desplegando microservicios y esperando su estado saludable..."
                sh 'docker compose --env-file "$DOTENV_FILE" up -d --build --wait --wait-timeout 180 $APP_SERVICES'

                echo "Ejecutando suite de pruebas BDD Cucumber..."
                sh '''
                    cd e2e-tests
                    chmod +x ./mvnw
                    rm -f reports/junit.xml reports/cucumber.json reports/cucumber.html
                    if ./mvnw test; then
                        echo "La suite BDD terminó correctamente."
                    else
                        echo "La suite BDD reportó fallos; se publicarán los resultados antes de marcar el build."
                    fi
                    test -s reports/junit.xml || { echo "ERROR: no se generó reports/junit.xml"; exit 1; }
                    test -s reports/cucumber.json || { echo "ERROR: no se generó reports/cucumber.json"; exit 1; }
                    test -s reports/cucumber.html || { echo "ERROR: no se generó reports/cucumber.html"; exit 1; }
                '''
            }
            post {
                always {
                    // 1. Resultados máquina-legibles JUnit XML
                    junit testResults: 'e2e-tests/reports/junit.xml', allowEmptyResults: true

                    // 2. Reporte navegable de escenarios BDD (plugin cucumber-reports)
                    cucumber(
                        jsonReportDirectory: 'e2e-tests/reports',
                        fileIncludePattern: '**/cucumber.json',
                        buildStatus: 'UNSTABLE'
                    )

                    // 3. Publicación HTML navegable (plugin htmlpublisher)
                    publishHTML(target: [
                        reportDir: 'e2e-tests/reports',
                        reportFiles: 'cucumber.html',
                        reportName: 'Reporte BDD',
                        keepAll: true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: true
                    ])

                    script {
                        if (env.APP_SERVICES?.trim()) {
                            // 4. Diagnóstico: archivar logs de los microservicios
                            sh 'docker compose --env-file "$DOTENV_FILE" logs $APP_SERVICES --no-color > docker-logs.txt || true'
                            archiveArtifacts artifacts: 'docker-logs.txt', allowEmptyArchive: true

                            // 5. Limpiar solo los servicios de la aplicación
                            echo "Limpiando microservicios de la aplicación..."
                            sh '''
                                    docker compose --env-file "$DOTENV_FILE" stop $APP_SERVICES || true
                                    docker compose --env-file "$DOTENV_FILE" rm -f -v $APP_SERVICES || true

                                    existing_volumes=$(docker volume ls --quiet)
                                    for volume in microservicios_empleado-data microservicios_departamento-data microservicios_notificaciones-data microservicios_perfiles-data microservicios_vacaciones-data microservicios_auth_db_data microservicios_rabbitmq-data; do
                                        if printf '%s\n' "$existing_volumes" | grep -Fxq "$volume"; then
                                            docker volume rm "$volume"
                                        fi
                                    done
                            '''
                        } else {
                            echo 'APP_SERVICES no está definido; se omiten logs y limpieza para no detener todo el proyecto Compose.'
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline finalizado'
        }
        success {
            echo 'Build, análisis SonarQube, empaquetado y pruebas E2E exitosos'
        }
        unstable {
            echo 'Compiló, pero hay pruebas fallando (UNSTABLE)'
        }
        failure {
            echo 'El pipeline ha fallado (error de compilación, Quality Gate o infraestructura)'
        }
    }
}

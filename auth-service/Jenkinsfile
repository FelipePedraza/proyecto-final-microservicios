pipeline {
    agent none
    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
    }
    environment {
        MVN_OPTS = '-B -Dmaven.repo.local=/tmp/.m2/repository'
    }
    stages {
        stage('Checkout') {
            agent any
            steps {
                checkout scm
                echo 'Código fuente obtenido'
            }
        }
        stage('Build') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21'
                    args '--network microservicios-network -v maven_repo_cache:/tmp -e HOME=/tmp'
                }
            }
            steps {
                dir('auth-service') {
                    sh 'mvn $MVN_OPTS clean compile -DskipTests'
                }
            }
        }
        stage('Test') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21'
                    args '--network microservicios-network -v maven_repo_cache:/tmp -e HOME=/tmp'
                }
            }
            steps {
                dir('auth-service') {
                    // verify ejecuta las pruebas y genera JaCoCo. Se deja que
                    // Surefire termine para que junit publique los fallos y marque
                    // el build UNSTABLE, en vez de abortar antes del bloque post.
                    sh 'mvn $MVN_OPTS verify -Dmaven.test.failure.ignore=true'
                }
            }
            post {
                always {
                    junit 'auth-service/target/surefire-reports/*.xml'
                    recordCoverage(
                        tools: [[parser: 'JACOCO', pattern: 'auth-service/target/site/jacoco/jacoco.xml']],
                        sourceDirectories: [[path: 'auth-service/src/main/java']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                    archiveArtifacts artifacts: 'auth-service/target/site/jacoco/**', allowEmptyArchive: true
                }
            }
        }
        stage('SonarQube Analysis') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21'
                    args '--network microservicios-network -v maven_repo_cache:/tmp -e HOME=/tmp'
                }
            }
            steps {
                dir('auth-service') {
                    withSonarQubeEnv('sonarqube') {
                        sh '''
                            mvn $MVN_OPTS \
                              org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                              -Dsonar.projectKey=auth-service \
                              -Dsonar.projectName=auth-service \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                              -Dsonar.token=$SONAR_AUTH_TOKEN
                        '''
                    }
                }
            }
        }
        stage('Quality Gate') {
            agent any
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Package') {
            agent any
            steps {
                script {
                    def imageName = "auth-service"
                    def imageTag = "${env.BUILD_NUMBER}"
                    echo "Empaquetando imagen Docker: ${imageName}:${imageTag}"
                    dir('auth-service') {
                        sh "docker build -t ${imageName}:${imageTag} -t ${imageName}:latest ."
                    }
                    echo "Imagen construida exitosamente: ${imageName}:${imageTag}"
                }
            }
        }
        stage('E2E Tests') {
            agent any
            environment {
                E2E_BASE_URL = 'http://gateway-service:8088'
                E2E_ADMIN_EMAIL = 'admin@empresa.com'
                E2E_ADMIN_PASSWORD = 'admin123'
                E2E_JWT_SECRET = 'SuperSecretaClaveDe256BitsMinimoParaQueFuncioneJJWTEnSpring2026!'
                VACACIONES_MANUAL_ENABLED = 'true'
            }
            steps {
                echo "Desplegando stack con Docker Compose para pruebas E2E..."
                sh 'docker compose -f docker-compose.yml up -d --build'

                echo "Esperando que los servicios alcancen estado saludable..."
                sh '''
                    for i in $(seq 1 30); do
                        if docker compose ps | grep -q "starting"; then
                            echo "Aún iniciando servicios (intento $i/30)..."
                            sleep 5
                        else
                            echo "Todos los servicios reportan estado listo/saludable."
                            break
                        fi
                    done
                '''

                echo "Ejecutando suite de pruebas BDD Cucumber..."
                sh '''
                    cd e2e-tests
                    ./mvnw test || true
                '''
            }
            post {
                always {
                    // 1. Resultados máquina-legibles JUnit XML
                    junit testResults: 'e2e-tests/reports/junit.xml', allowEmptyResults: true

                    // 2. Reporte navegable de escenarios BDD (plugin cucumber-reports)
                    cucumber(
                        jsonReportDirectory: 'e2e-tests/reports',
                        fileIncludePattern: '**/cucumber.json',
                        buildStatus: 'UNSTABLE'
                    )

                    // 3. Publicación HTML navegable (plugin htmlpublisher)
                    publishHTML(target: [
                        reportDir: 'e2e-tests/reports',
                        reportFiles: 'cucumber.html',
                        reportName: 'Reporte BDD',
                        keepAll: true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: true
                    ])

                    // 4. Diagnóstico: archivar logs del ecosistema Docker
                    sh 'docker compose logs --no-color > docker-logs.txt || true'
                    archiveArtifacts artifacts: 'docker-logs.txt', allowEmptyArchive: true

                    // 5. Limpieza: apagar el stack y borrar volúmenes
                    echo "Limpiando infraestructura de pruebas E2E..."
                    sh 'docker compose -f docker-compose.yml down -v'
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline finalizado'
        }
        success {
            echo 'Build, análisis SonarQube, empaquetado y pruebas E2E exitosos'
        }
        unstable {
            echo 'Compiló, pero hay pruebas fallando (UNSTABLE)'
        }
        failure {
            echo 'El pipeline ha fallado (error de compilación, Quality Gate o infraestructura)'
        }
    }
}

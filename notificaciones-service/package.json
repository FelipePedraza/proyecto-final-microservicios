{
  "name": "notificaciones-service",
  "version": "1.0.0",
  "description": "Reto 4 - Integrante 2: consume eventos de empleados-service y simula el envio de notificaciones, guardando un historial consultable.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --require @opentelemetry/auto-instrumentations-node/register src/server.js",
    "dev": "node --watch --require @opentelemetry/auto-instrumentations-node/register src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.3",
    "amqplib": "^0.10.4",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}

ASPNETCORE_ENVIRONMENT=Development
# Los secretos quedan vacíos intencionalmente: genera valores únicos antes de iniciar Compose.
# Configuracion de los servicios y sus puertos
# Puertos internos de los servicios.
EMPLEADO_SERVICE_PORT=8080
DEPARTAMENTO_SERVICE_PORT=8081
GATEWAY_SERVER_PORT=8088
NOTIFICACIONES_SERVICE_PORT=8082
PERFILES_SERVICE_PORT=8083
VACACIONES_SERVICE_PORT=8085
AUTH_SERVICE_PORT=8089
EMPLEADO_SERVICE_IMAGE_TAG=latest
AUTH_SERVICE_IMAGE_TAG=latest
# Puertos publicados en la máquina anfitriona.
HOST_BIND_IP=127.0.0.1
GATEWAY_SERVICE_PORT=8088

# Configuracion del API Gateway dentro de la red Docker
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5s
EMPLEADOS_SERVICE_URL=http://empleado-service:8080
DEPARTAMENTO_SERVICE_URL=http://departamento-service:8081
NOTIFICACIONES_SERVICE_URL=http://notificaciones-service:8082
PERFILES_SERVICE_URL=http://perfiles-service:8083
VACACIONES_SERVICE_URL=http://vacaciones-service:8085
AUTH_SERVICE_URL=http://auth-service:8089

# Base de datos exclusiva de empleado-service
EMPLEADO_DB_HOST=empleado-db
EMPLEADO_DB_PORT=5432
EMPLEADO_DB_NAME=empleado_db
EMPLEADO_DB_USER=empleado_user
EMPLEADO_DB_PASSWORD=

# Base de datos exclusiva de DepartamentoService
DEPARTAMENTO_DB_HOST=departamento-db
DEPARTAMENTO_DB_PORT=5432
DEPARTAMENTO_DB_NAME=departamento_db
DEPARTAMENTO_DB_USER=departamento_user
DEPARTAMENTO_DB_PASSWORD=

# Circuit breaker de EmpleadoService hacia DepartamentoService
# FALLOS_CONSECUTIVOS: 3 a 5 | DURACION_CIRCUITO_ABIERTO: entre 00:00:30 y 00:01:00 | TIMEOUT_LLAMADA: 5 s
CB_FALLOS_CONSECUTIVOS=3
CB_TIMEOUT_LLAMADA=00:00:05
CB_DURACION_CIRCUITO_ABIERTO=00:00:30

# RabbitMQ compartido por EmpleadoService y notificaciones-service
RABBITMQ_HOST=message-broker
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_ERLANG_COOKIE=
RABBITMQ_EXCHANGE=empleados_exchange
NOTIFICACIONES_RABBITMQ_QUEUE=notificaciones.empleados
NOTIFICACIONES_RABBITMQ_DLQ=notificaciones.empleados.dlq
RABBITMQ_AUTH_EXCHANGE=auth_exchange
NOTIFICACIONES_RABBITMQ_AUTH_QUEUE=notificaciones.auth
NOTIFICACIONES_RABBITMQ_AUTH_DLQ=notificaciones.auth.dlq
RABBITMQ_RECONEXION_MS=5000

# Base de datos exclusiva de notificaciones-service (Reto 4 - Integrante 2)
NOTIFICACIONES_DB_HOST=notificaciones-db
NOTIFICACIONES_DB_PORT=5432
NOTIFICACIONES_DB_NAME=notificaciones_db
NOTIFICACIONES_DB_USER=notificaciones_user
NOTIFICACIONES_DB_PASSWORD=

# Base de datos exclusiva de perfiles-service
PERFILES_DB_HOST=perfiles-db
PERFILES_DB_PORT=5432
PERFILES_DB_NAME=perfiles_db
PERFILES_DB_USER=perfiles_user
PERFILES_DB_PASSWORD=
PERFILES_RABBITMQ_QUEUE=perfiles.empleados

# Base de datos exclusiva de vacaciones-service (Reto 4)
VACACIONES_DB_HOST=vacaciones-db
VACACIONES_DB_PORT=5432
VACACIONES_DB_NAME=vacaciones_db
VACACIONES_DB_USER=vacaciones_user
VACACIONES_DB_PASSWORD=
VACACIONES_RABBITMQ_QUEUE=vacaciones.empleados
# Cron Spring de seis campos; por defecto, una vez por minuto.
VACACIONES_CRON=0 * * * * *
# Habilita endpoints manuales de demostracion, siempre detras del Gateway (rol ADMIN).
# Debe ser true para ejecutar e2e-tests (ciclo de vacaciones: forzar-inicio / forzar-fin); en produccion, false.
VACACIONES_MANUAL_ENABLED=false

# Base de datos y firma JWT exclusivas de auth-service (Reto 5)
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=
# Debe tener al menos 32 bytes y ser igual en auth-service (firma) y en
# gateway-service (validacion). Genera un valor aleatorio de al menos 32 bytes.
JWT_SECRET_KEY=
# Administrador semilla de auth-service (se crea solo si no existe). Cambiar la clave.
# Sin valor por defecto en el codigo: si falta, auth-service no arranca fuera de Docker.
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=

# Jenkins (Reto 7, Punto 2). Sustituye el valor vacío en tu .env local.
JENKINS_ROOT_URL=http://localhost:9090/
GITHUB_REPOSITORY_URL=https://github.com/FelipePedraza/proyecto-final-microservicios.git
JENKINS_ADMIN_USERNAME=admin
JENKINS_ADMIN_PASSWORD=
# Docker Desktop usa 0; en Linux, reemplazar por el gid de /var/run/docker.sock.
DOCKER_GID=0

# SonarQube (Reto 7, Punto 3)
# URL usada por Jenkins dentro de la red de Docker.
JENKINS_SONARQUBE_URL=http://sonarqube:9000
SONARQUBE_HOST_PORT=9000
SONAR_DB_HOST=sonar-db
SONAR_DB_PORT=5432
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=
# Primero levanta sonar-db y sonarqube, crea el token en http://localhost:9000
# http://localhost:9000 y pega aquí el valor real antes de levantar Jenkins.
# Para aprovisionar QualityGate70 y el webhook, ejecuta
# python tools/provision_sonarqube.py; el token de administrador se solicita
# de forma interactiva y no debe guardarse en este archivo.
# y luego pega aquí el valor real antes de levantar/recrear Jenkins.
SONAR_TOKEN=
SONAR_TOKEN_USER=
# Pruebas E2E y Jenkins
# Jenkins monta el .env como archivo de solo lectura y usa este URL interno para E2E.
E2E_BASE_URL=http://localhost:8088
JENKINS_E2E_BASE_URL=http://gateway-service:8088
JENKINS_HOST_PORT=9090
JENKINS_AGENT_PORT=50000
E2E_ADMIN_EMAIL=admin@empresa.com
E2E_ADMIN_PASSWORD=
# Debe coincidir con JWT_SECRET_KEY; solo se usa para los tokens temporales E2E.
E2E_JWT_SECRET=
APP_SERVICES=gateway-service empleado-service departamento-service perfiles-service notificaciones-service vacaciones-service auth-service message-broker empleado-db departamento-db perfiles-db notificaciones-db vacaciones-db auth-db

#Reto 8
ZIPKIN_HOST_PORT=9411
LOKI_HOST_PORT=3100

# Grafana (Reto 8)
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_HOST_PORT=9091
PROMETHEUS_DATASOURCE_URL=http://prometheus:9090
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
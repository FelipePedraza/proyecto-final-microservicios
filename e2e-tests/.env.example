# Variables de las pruebas E2E (BDD). Copiar a .env y exportarlas en la terminal, o pasarlas con -D.
# Prioridad: variable de entorno > propiedad de sistema (-De2e.xxx) > valor por defecto.

# URL del API Gateway (único puerto publicado por docker-compose). Por defecto http://localhost:8088
E2E_BASE_URL=http://localhost:8088

# Credenciales de un usuario ADMIN existente (las mismas ADMIN_EMAIL / ADMIN_PASSWORD del .env raíz).
# No se versionan: solo las necesitan los escenarios que hacen login (seguridad, onboarding, offboarding).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Segundos que se espera a que el gateway responda antes de dar el sistema por caído
E2E_STARTUP_TIMEOUT_SECONDS=60
# Timeout de cada petición HTTP en milisegundos
E2E_REQUEST_TIMEOUT_MS=30000

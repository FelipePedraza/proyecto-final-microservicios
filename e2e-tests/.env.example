# Variables de las pruebas E2E (BDD). Copiar a .env y exportarlas en la terminal, o pasarlas con -D.
# Prioridad: variable de entorno > propiedad de sistema (-De2e.xxx) > valor por defecto.

# URL del API Gateway (único puerto publicado por docker-compose). Por defecto http://localhost:8088
E2E_BASE_URL=http://localhost:8088

# Credenciales de un usuario ADMIN existente (las mismas ADMIN_EMAIL / ADMIN_PASSWORD del .env raíz).
# No se versionan: solo las necesitan los escenarios que hacen login (seguridad, onboarding, offboarding).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Credenciales de una cuenta USER activa creada mediante el flujo de onboarding.
# Son obligatorias para ejecutar los escenarios @seguridad que validan RBAC de USER.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Segundos que se espera a que el gateway responda antes de dar el sistema por caído
E2E_STARTUP_TIMEOUT_SECONDS=120
# Timeout de cada petición HTTP en milisegundos
E2E_REQUEST_TIMEOUT_MS=30000

# Polling para resultados asincrónicos: 15 intentos, cada 2 s, con tope total de 90 s (cubre una petición lenta de hasta 30 s más reintentos).
E2E_POLLING_MAX_ATTEMPTS=15
E2E_POLLING_INTERVAL_MS=2000
E2E_POLLING_TIMEOUT_SECONDS=90

# Requisito del sistema (no de esta suite): el .env raiz debe tener VACACIONES_MANUAL_ENABLED=true
# para que el ciclo de vacaciones pueda forzar el inicio y el fin del periodo.

# Debe coincidir con JWT_SECRET_KEY del stack. Solo se usa para activar cuentas efímeras E2E.
E2E_JWT_SECRET=

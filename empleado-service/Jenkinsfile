pipeline {
    agent none
    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
    }
    stages {
        stage('Checkout') {
            agent any
            steps {
                checkout scm
                echo 'Código fuente de empleado-service obtenido'
            }
        }
        stage('Build') {
            agent {
                docker {
                    image 'dotnet-sonar:10.0-sonarscanner-9.2.1'
                    args '--network microservicios-network -v dotnet_cache:/root/.nuget/packages'
                }
            }
            steps {
                dir('empleado-service') {
                    sh 'dotnet build EmpleadoService.sln -c Release'
                }
            }
        }
        stage('Test') {
            agent {
                docker {
                    image 'dotnet-sonar:10.0-sonarscanner-9.2.1'
                    args '--network microservicios-network -v dotnet_cache:/root/.nuget/packages'
                }
            }
            steps {
                dir('empleado-service') {
                    // || true permite que la ejecución continúe al bloque post para publicar reportes
                    sh 'dotnet test EmpleadoService.sln -c Release --logger "trx;LogFileName=test-results.trx" --collect "XPlat Code Coverage" -- DataCollectionRunSettings.DataCollectors.DataCollector.Configuration.Format=opencover,cobertura || true'
                }
                stash name: 'empleado-coverage-reports', includes: 'empleado-service/**/coverage.opencover.xml,empleado-service/**/coverage.cobertura.xml'
            }
            post {
                always {
                    mstest testResultsFile: 'empleado-service/**/test-results.trx'
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: 'empleado-service/**/coverage.cobertura.xml']],
                        sourceDirectories: [[path: 'empleado-service/empleadoService']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                }
            }
        }
        stage('SonarQube Analysis') {
            agent {
                docker {
                    image 'dotnet-sonar:10.0-sonarscanner-9.2.1'
                    args '--network microservicios-network -v dotnet_cache:/root/.nuget/packages'
                }
            }
            steps {
                unstash 'empleado-coverage-reports'
                dir('empleado-service') {
                    withSonarQubeEnv('sonarqube') {
                        sh '''
                            dotnet-sonarscanner begin \
                                /k:"empleado-service" \
                                /n:"empleado-service" \
                                /d:sonar.host.url="${SONAR_HOST_URL}" \
                                /d:sonar.login="${SONAR_AUTH_TOKEN}" \
                                /d:sonar.cs.opencover.reportsPaths="**/coverage.opencover.xml" \
                                /d:sonar.exclusions="**/migrations/**" \
                                /d:sonar.coverage.exclusions="**/migrations/**,**/*.Tests/**" \
                                /d:sonar.scanner.scanAll=false

                            dotnet build EmpleadoService.sln -c Release --no-incremental

                            dotnet-sonarscanner end /d:sonar.login="${SONAR_AUTH_TOKEN}"
                        '''
                    }
                }
            }
        }
        stage('Quality Gate') {
            agent any
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Package') {
            agent any
            steps {
                script {
                    def imageName = "empleado-service"
                    def imageTag = "${env.BUILD_NUMBER}"
                    echo "Empaquetando imagen Docker: ${imageName}:${imageTag}"
                    dir('empleado-service') {
                        sh "docker build -t ${imageName}:${imageTag} -t ${imageName}:latest ."
                    }
                    echo "Imagen construida exitosamente: ${imageName}:${imageTag}"
                }
            }
        }
        stage('E2E Tests') {
            agent any
            steps {
                script {
                    def config = readProperties(file: env.DOTENV_FILE)
                    def e2eConfig = [
                        E2E_BASE_URL: config.JENKINS_E2E_BASE_URL ?: config.E2E_BASE_URL,
                        E2E_ADMIN_EMAIL: config.E2E_ADMIN_EMAIL,
                        E2E_ADMIN_PASSWORD: config.E2E_ADMIN_PASSWORD,
                        E2E_JWT_SECRET: config.JWT_SECRET_KEY,
                        APP_SERVICES: config.APP_SERVICES
                    ]
                    def missing = e2eConfig.findAll { key, value -> !value?.trim() }.keySet()
                    if (missing) {
                        error "Faltan variables requeridas en el Secret file credential microservicios-env: ${missing.join(', ')}"
                    }
                    e2eConfig.each { key, value -> env[key] = value }
                    env.EMPLEADO_SERVICE_IMAGE_TAG = env.BUILD_NUMBER
                    env.VACACIONES_MANUAL_ENABLED = 'true'
                }

                echo "Limpiando estado previo de microservicios y volumenes..."
                sh '''
                    docker compose --env-file "$DOTENV_FILE" stop $APP_SERVICES || true
                    docker compose --env-file "$DOTENV_FILE" rm -f -v $APP_SERVICES || true
                    docker volume rm -f microservicios_empleado-data microservicios_departamento-data microservicios_notificaciones-data microservicios_perfiles-data microservicios_vacaciones-data microservicios_auth_db_data microservicios_rabbitmq-data || true
                '''

                echo "Desplegando microservicios de la aplicación para pruebas E2E..."
                echo "Desplegando microservicios y esperando su estado saludable..."
                sh 'docker compose --env-file "$DOTENV_FILE" up -d --build --wait --wait-timeout 180 $APP_SERVICES'

                echo "Ejecutando suite de pruebas BDD Cucumber..."
                sh '''
                    cd e2e-tests
                    chmod +x ./mvnw
                    rm -f reports/junit.xml reports/cucumber.json reports/cucumber.html
                    if ./mvnw test; then
                        echo "La suite BDD terminó correctamente."
                    else
                        echo "La suite BDD reportó fallos; se publicarán los resultados antes de marcar el build."
                    fi
                    test -s reports/junit.xml || { echo "ERROR: no se generó reports/junit.xml"; exit 1; }
                    test -s reports/cucumber.json || { echo "ERROR: no se generó reports/cucumber.json"; exit 1; }
                    test -s reports/cucumber.html || { echo "ERROR: no se generó reports/cucumber.html"; exit 1; }
                '''
            }
            post {
                always {
                    // 1. Resultados máquina-legibles JUnit XML
                    junit testResults: 'e2e-tests/reports/junit.xml', allowEmptyResults: true

                    // 2. Reporte navegable de escenarios BDD (plugin cucumber-reports)
                    cucumber(
                        jsonReportDirectory: 'e2e-tests/reports',
                        fileIncludePattern: '**/cucumber.json',
                        buildStatus: 'UNSTABLE'
                    )

                    // 3. Publicación HTML navegable (plugin htmlpublisher)
                    publishHTML(target: [
                        reportDir: 'e2e-tests/reports',
                        reportFiles: 'cucumber.html',
                        reportName: 'Reporte BDD',
                        keepAll: true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: true
                    ])

                    // 4. Diagnóstico: archivar logs del ecosistema Docker
                    sh 'docker compose --env-file "$DOTENV_FILE" logs $APP_SERVICES --no-color > docker-logs.txt || true'
                    archiveArtifacts artifacts: 'docker-logs.txt', allowEmptyArchive: true

                    // 5. Limpieza: apagar y remover contenedores y volúmenes de datos
                    echo "Limpiando infraestructura de pruebas E2E..."
                    sh '''
                        docker compose --env-file "$DOTENV_FILE" stop $APP_SERVICES || true
                        docker compose --env-file "$DOTENV_FILE" rm -f -v $APP_SERVICES || true

                        existing_volumes=$(docker volume ls --quiet)
                        for volume in microservicios_empleado-data microservicios_departamento-data microservicios_notificaciones-data microservicios_perfiles-data microservicios_vacaciones-data microservicios_auth_db_data microservicios_rabbitmq-data; do
                            if printf '%s\n' "$existing_volumes" | grep -Fxq "$volume"; then
                                docker volume rm "$volume"
                            fi
                        done
                    '''
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline de empleado-service finalizado'
        }
        success {
            echo 'Build, análisis SonarQube, empaquetado y pruebas E2E exitosos'
        }
        unstable {
            echo 'Compiló, pero hay pruebas fallando (UNSTABLE)'
        }
        failure {
            echo 'El pipeline ha fallado (error de compilación, Quality Gate o infraestructura)'
        }
    }
}
